# URL do servidor Socket.io (para multiplayer)
# Em dev: http://localhost:3001
# Em produção: https://seu-servidor.com
VITE_SERVER_URL=

# Chave da API do Giphy para buscar GIFs no chat (OPCIONAL)
# Crie grátis em https://developers.giphy.com e cole a chave aqui.
# Sem chave, o chat mostra GIFs fofos de casal prontos (pixel art) —
# não precisa de nenhuma API externa. Com chave, vira busca normal.
VITE_GIPHY_KEY=